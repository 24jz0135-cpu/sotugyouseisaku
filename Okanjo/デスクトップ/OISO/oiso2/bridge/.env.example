# Keep this file private. Do not commit a real token.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PORT=8788
# mock: creates reviewable blank records; codex: runs the locally signed-in Codex CLI
ANALYZER_MODE=mock
CODEX_COMMAND=codex
# trueにすると、Discordから受信した画像を固定のレシート解析ジョブとして自動処理します。
# 初回はfalseで受信・CSVの流れを検証してから有効にしてください。
AUTO_ANALYZE=false

# 共通Bot（Oracle Cloud）を使う場合。Discordの個人Bot設定は不要。
COMMON_RELAY_URL=https://relay.example.com
# 初回ペアリング後はbridge-data/common-relay.jsonへ自動保存されるため空欄でよい。
COMMON_RELAY_DEVICE_TOKEN=
